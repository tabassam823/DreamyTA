	doi = {10.3390/e24111676},
	abstract = {In this paper, we present an analytical description of emergence from the density matrix framework as a state of knowledge of the system, and its generalized probability formulation. This description is based on the idea of fragile systems, wherein the observer modifies the system by the measurement (i.e., the observer effect) in order to detect possible emergent behavior. We propose the use of a descriptor, based on quantum mutual information, to calculate if subsystems of systems have inner correlations. This may contribute to a definition of emergent systems in terms of emergent information.},
