@article{hidalgo_quantum_2006,
	title = {Quantum {Econophysics}},
	copyright = {arXiv.org perpetual, non-exclusive license},
	url = {https://arxiv.org/abs/physics/0609245},
	doi = {10.48550/ARXIV.PHYSICS/0609245},
	abstract = {The relationships between game theory and quantum mechanics let us propose certain quantization relationships through which we could describe and understand not only quantum but also classical, evolutionary and the biological systems that were described before through the replicator dynamics. Quantum mechanics could be used to explain more correctly biological and economical processes and even it could encloses theories like games and evolutionary dynamics. This could make quantum mechanics a more general theory that we had thought. Although both systems analyzed are described through two apparently different theories (quantum mechanics and game theory) it is shown that both systems are analogous and thus exactly equivalents. So, we can take some concepts and definitions from quantum mechanics and physics for the best understanding of the behavior of economics and biology. Also, we could maybe understand nature like a game in where its players compete for a common welfare and the equilibrium of the system that they are members.},
